# Root data-plane helpers read the process environment; they do not load this file.
# Export reviewed values explicitly. This sample grants no permission to deploy,
# create agents, seed M365 data or write to Fabric. Complete target governance first.

# The root wrapper binds helpers to its explicitly selected CLI tenant/subscription.
# For direct helper invocation choose and review the authentication mode explicitly.
AZURE_AUTH_MODE=azure_cli
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# agent/create_agent.py and data/foundry-iq/index_cm_policies.py
# Populate from the selected deployment's outputs, not from an existing estate.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
FOUNDRY_AGENT_NAME=
# Classic agent modes: local (synthetic tools) or hybrid (live Search and Bing).
IQ_MODE=
CM_CLIENT_ID=
BING_GROUNDING_CONNECTION=
# Hybrid mode needs the full reviewed connection resource ID, not just its name.
BING_GROUNDING_CONNECTION_ID=
SEARCH_ENDPOINT=
SEARCH_INDEX=
SEARCH_SEMANTIC_CONFIGURATION=
# Used only when direct invocation explicitly selects AZURE_AUTH_MODE=admin_key.
SEARCH_ADMIN_KEY=

# data/work-iq/seed_work_iq.py
# Set credentials only in the local process/secret store, never in this sample.
WORKIQ_TENANT_ID=
WORKIQ_CLIENT_ID=
WORKIQ_CLIENT_SECRET=
# Absolute paths; driver_alias and explicit UPNs are supplied inside the mapping.
WORKIQ_USER_MAPPING_FILE=
WORKIQ_RESTORE_FILE=
WORKIQ_SEEDER_APP_NAME=

# app/infra registration helpers
INFRA_SPA_NAME=
INFRA_BFF_NAME=

# data/fabric-iq/deploy_fabric.py (all names explicitly selected by the deployer)
FABRIC_CAPACITY_NAME=
FABRIC_WORKSPACE_NAME=
FABRIC_LAKEHOUSE_NAME=
FABRIC_LOAD_NOTEBOOK_NAME=
FABRIC_SEMANTIC_NOTEBOOK_NAME=
FABRIC_SEMANTIC_MODEL_NAME=

# agent/create_agent.py creates a classic AgentsClient assistant.
# It does not provision the Responses named agent required by the app's
# FOUNDRY_AGENT_NAME. Configure that named agent separately in the chosen project.
# Fabric provisioning selects its capacity through the explicit --capacity option;
# the root deployment wrapper also requires its explicit target/local parameters.
