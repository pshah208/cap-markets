# The image runs `npm ci` itself. Copying a host-built node_modules in breaks the
# build: binaries built on Windows are not executable in the Linux image, which
# surfaces as "sh: tsc: Permission denied".
node_modules
dist
.env
.env.*
*.tsbuildinfo
.vite
npm-debug.log*
.bank-config-test-*
.bank-build-test-*
# Deliberately include public/brand: Docker validates the deployment-local config.
