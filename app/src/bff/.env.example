# Local BFF process environment. Do not commit populated values or secrets.
# Export/load these before importing app.config; this sample is not auto-loaded.
AAD_TENANT_ID=
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=
AAD_API_SCOPE=
FOUNDRY_SCOPE=https://ai.azure.com/.default

FOUNDRY_PROJECT_ENDPOINT=
# Required Responses agent NAME, not the classic assistant ID from create_agent.py.
FOUNDRY_AGENT_NAME=
# Optional named agents: configure explicitly before using their corresponding flows.
SCENARIO_AGENT_NAME=
MISSION_AGENT_NAME=
BARRIER_AGENT_NAME=
# Legacy configuration field; does not replace FOUNDRY_AGENT_NAME in Responses.
FOUNDRY_AGENT_ID=

LOG_ANALYTICS_WORKSPACE_ID=
TELEMETRY_WINDOW_DAYS=7
APPLICATIONINSIGHTS_CONNECTION_STRING=
COST_SCOPE=
COST_WINDOW_DAYS=30

# Full ARM capacity resource ID. Keep both blank to disable capacity control.
# Use an explicit comma-separated UPN allow-list; do not imply every user is allowed.
FABRIC_CAPACITY_ID=
FABRIC_CAPACITY_OPERATORS=
# Explicit Fabric identifiers passed by IaC; consuming configuration is separately owned.
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=
FABRIC_SEMANTIC_MODEL_ID=

# Optional user-assigned managed identity client ID for DefaultAzureCredential.
AZURE_CLIENT_ID=
ALLOW_APP_IDENTITY_FALLBACK=false
MOCK_MODE=false
CORS_ORIGINS=http://localhost:5173
